<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.dataflowanalysis.vendor</groupId>
		<artifactId>parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../../</relativePath>
	</parent>
	<artifactId>de.uka.ipd.sdq.stoex.analyser</artifactId>
	<version>5.2.2</version>
	<packaging>pom</packaging>

	<dependencies>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.probfunction</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.probfunction.math</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.stoex</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.units</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.errorhandling.core</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>log4j</groupId>
			<artifactId>log4j</artifactId>
			<version>1.2.17</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-vendor-jar</id>
						<phase>package</phase>
						<goals>
							<goal>attach-artifact</goal>
						</goals>
						<configuration>
							<artifacts>
								<artifact>
									<file>${project.basedir}/lib/de.uka.ipd.sdq.stoex.analyser-5.2.2.jar</file>
									<type>jar</type>
								</artifact>
							</artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
