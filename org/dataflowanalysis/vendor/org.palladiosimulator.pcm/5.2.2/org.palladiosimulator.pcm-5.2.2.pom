<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.dataflowanalysis.vendor</groupId>
		<artifactId>parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../../</relativePath>
	</parent>
	<artifactId>org.palladiosimulator.pcm</artifactId>
	<version>5.2.2</version>
	<packaging>pom</packaging>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.core.runtime</artifactId>
			<version>3.33.100</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore</artifactId>
			<version>2.36.0</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.eclipse.ocl</artifactId>
			<version>3.18.0.v20221201-0557</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.eclipse.ocl.ecore</artifactId>
			<version>3.18.0.v20221201-0557</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.eclipse.emf.cdo</artifactId>
			<version>4.21.0.v20230221-1613</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore.xmi</artifactId>
			<version>2.37.0</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.identifier</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.probfunction</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.stoex</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.units</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>de.uka.ipd.sdq.errorhandling.core</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext</artifactId>
			<version>2.35.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.xbase</artifactId>
			<version>2.35.0</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.antlr.runtime</artifactId>
			<version>3.2.0.v20220404-1927</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.xbase.lib</artifactId>
			<version>2.35.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.util</artifactId>
			<version>2.35.0</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.palladiosimulator.commons.stoex</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.dataflowanalysis.vendor</groupId>
			<artifactId>org.palladiosimulator.commons</artifactId>
			<version>5.2.2</version>
		</dependency>
		<dependency>
			<groupId>javax.inject</groupId>
			<artifactId>javax.inject</artifactId>
			<version>1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-vendor-jar</id>
						<phase>package</phase>
						<goals>
							<goal>attach-artifact</goal>
						</goals>
						<configuration>
							<artifacts>
								<artifact>
									<file>${project.basedir}/lib/org.palladiosimulator.pcm-5.2.2.jar</file>
									<type>jar</type>
								</artifact>
							</artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
